{
  "name": "pdf-ingestion-pipeline",
  "description": "PDF document ingestion pipeline - parse, enhance, chunk, and index",
  "nodes": [
    {
      "nodeId": "fetcher-1",
      "nodeType": "fetcher",
      "nextNodeId": "parser-1"
    },
    {
      "nodeId": "parser-1",
      "nodeType": "parser",
      "settings": {
        "rules": [
          {
            "mimeType": "PDF"
          }
        ]
      },
      "nextNodeId": "enhancer-1"
    },
    {
      "nodeId": "enhancer-1",
      "nodeType": "enhancer",
      "settings": {
        "modelId": "qwen3.5-plus-2026-02-15",
        "tasks": [
          {
            "type": "context_enhance",
            "systemPrompt": "Clean up parsed PDF text formatting without changing the original meaning.",
            "userPromptTemplate": "Please clean up this PDF text:\n\n{{text}}"
          }
        ]
      },
      "nextNodeId": "chunker-1"
    },
    {
      "nodeId": "chunker-1",
      "nodeType": "chunker",
      "settings": {
        "strategy": "fixed_size",
        "chunkSize": 512,
        "overlapSize": 128
      },
      "nextNodeId": "indexer-1"
    },
    {
      "nodeId": "indexer-1",
      "nodeType": "indexer",
      "settings": {
        "embeddingModel": "qwen-emb-8b",
        "includeEnhancedContent": true,
        "metadataFields": [
          "category",
          "department"
        ]
      }
    }
  ]
}
